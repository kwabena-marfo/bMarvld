# MongoDB Atlas connection. Collections: bookings, dateLocks, photos, loginCodes (in MONGODB_DB).
MONGODB_URI="mongodb+srv://user:password@cluster0.xxxxx.mongodb.net"
MONGODB_DB="bmarvld"

# Paystack (https://dashboard.paystack.com/#/settings/developers).
# Use sk_test_… while testing. Set the webhook URL in the dashboard to
# https://<your-domain>/api/paystack/webhook
PAYSTACK_SECRET_KEY="sk_test_xxx"

# Public site URL, used for Paystack's post-payment redirect. Falls back to
# the request origin when unset (fine locally).
APP_URL="http://localhost:3000"

# Admin area (/admin). Comma-separated emails allowed to sign in; each gets a
# 6-digit login code by email. Removing an email locks that person out at once.
ADMIN_EMAILS="you@gmail.com,other@gmail.com"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# Gmail SMTP used to send admin login codes.
# Generate an app password at https://myaccount.google.com/apppasswords
SMTP_USER="you@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"

# Cloudinary, stores gallery photos uploaded from /admin/gallery.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="bmarvld/gallery"

# mNotify SMS (https://app.mnotify.com → API). The sender ID must be approved
# on mNotify first (max 11 characters), or texts won't send.
MNOTIFY_KEY=""
MNOTIFY_SENDER_ID="BMarvld"
# The photographer's number, texted on every new booking.
ADMIN_PHONE="0240000000"
